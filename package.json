{
  "name": "autonomous-qa-engine",
  "type": "module",
  "version": "1.0.0",
  "description": "Continuous Quality Gate for Web Applications, REST APIs, and Generative AI (LLM / RAG) Systems",
  "author": "Marttin Roman <marttinroman@gmail.com>",
  "license": "MIT",
  "keywords": [
    "playwright",
    "test-automation",
    "sdet",
    "ai-testops",
    "rag-evaluation",
    "quality-gate",
    "allure"
  ],
  "main": "index.js",
  "scripts": {
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/integration",
    "test:ai": "python3 -m pytest tests/ai_eval -v",
    "test:all": "playwright test && python3 -m pytest tests/ai_eval -v",
    "test:ui": "playwright test --ui",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "api:sync": "bun cli/sync-openapi.ts",
    "mock:server": "bun tests/server/mockServer.ts",
    "up": "bun cli/update-template.js",
    "resend": "bun cli/resend.ts",
    "xray": "bun cli/xray/index.ts",
    "xray:skills": "cp -r cli/xray/skills/ .claude/skills/xray-cli/",
    "jira:sync": "bun scripts/jira-sync.ts",
    "lint:agents": "bun run scripts/agents-lint.ts",
    "jira:sync-fields": "bun run scripts/sync-jira-fields.ts",
    "jira:check": "bun run scripts/check-jira-setup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky"
  },
  "dependencies": {
    "@faker-js/faker": "^9.6.0",
    "@inquirer/prompts": "^8.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.7",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.0",
    "@playwright/test": "^1.51.0",
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "allure-playwright": "^3.2.0",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
