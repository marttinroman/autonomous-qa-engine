{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleDetection": "force",
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@api/*": ["tests/components/api/*"],
      "@config/*": ["config/*"],
      "@fixtures/*": ["tests/components/*"],
      "@schemas/*": ["tests/schemas/*"],
      "@steps/*": ["tests/components/steps/*"],
      "@ui/*": ["tests/components/ui/*"],
      "@utils/*": ["tests/utils/*"],
      "@variables": ["config/variables.ts"]
    },
    "resolveJsonModule": true,
    "types": ["bun-types", "node", "@playwright/test"],
    "strict": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "allure-report", "allure-results", "playwright-report"]
}
